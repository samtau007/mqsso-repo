# Copy to .env.local for development. In Vercel, set these as environment variables.
# Generate every secret with: node scripts/generate-secrets.mjs

# Postgres (Supabase project, used only as the database). Use the session pooler string.
DATABASE_URL=postgres://user:password@host:5432/postgres

# Public addresses. In development use *.localhost, which browsers send to this machine.
MQ_ID_ORIGIN=http://id.localhost:3000
MQ_SITE_ORIGIN=http://localhost:3000
MQ_DEVELOPERS_ORIGIN=http://developers.localhost:3000
MQ_RELAY_DOMAIN=relay.muslimquotient.com

# Secrets. Never commit real values. MQ_PAIRWISE_SALT and MQ_INDEX_KEY must never change once
# people have signed up: they decide every private ID and every email lookup.
MQ_JWKS=
MQ_COOKIE_KEYS=
MQ_VAULT_KEY=
MQ_INDEX_KEY=
MQ_SESSION_KEY=
MQ_PAIRWISE_SALT=
CRON_SECRET=

# Login code email through Resend. Leave empty in development: codes are printed in the server log.
RESEND_API_KEY=
MQ_MAIL_FROM=Muslim Quotient <codes@id.muslimquotient.com>

# Developer portal accounts that may approve platforms and set sector groups (comma separated).
MQ_PORTAL_ADMINS=

# Starter sign-up page until M2 moves muslimquotient.com onto the sign-in service.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
