# Copy to .env.local for development. In Vercel, set these as environment variables.
# Generate every secret with: node scripts/generate-secrets.mjs

# Postgres (Supabase project, used only as the database). On Vercel, the Supabase
# integration sets POSTGRES_URL and POSTGRES_URL_NON_POOLING itself; DATABASE_URL is
# then not needed. Locally, set either.
DATABASE_URL=postgres://user:password@host:6543/postgres

# Public addresses. In development use hosts under one *.localhost name, which browsers send to
# this machine and treat as one site for passkeys (www.mq.localhost, id.mq.localhost, ...).
# In production the website is https://www.muslimquotient.com (the bare domain redirects there).
MQ_ID_ORIGIN=http://id.mq.localhost:3000
MQ_SITE_ORIGIN=http://www.mq.localhost:3000
MQ_DEVELOPERS_ORIGIN=http://developers.mq.localhost:3000
MQ_API_ORIGIN=http://api.mq.localhost:3000
MQ_RELAY_DOMAIN=relay.muslimquotient.com

# Secrets. Never commit real values. MQ_PAIRWISE_SALT and MQ_INDEX_KEY must never change once
# people have signed up: they decide every private ID and every email lookup.
MQ_JWKS=
MQ_COOKIE_KEYS=
MQ_VAULT_KEY=
MQ_INDEX_KEY=
MQ_SESSION_KEY=
MQ_PAIRWISE_SALT=
CRON_SECRET=

# Login code email through Resend. Leave empty in development: codes are printed in the server log.
RESEND_API_KEY=
MQ_MAIL_FROM=Muslim Quotient <codes@id.muslimquotient.com>

# Developer portal accounts that may approve platforms and set sector groups (comma separated).
MQ_PORTAL_ADMINS=

# muslimquotient.com signs in like any platform: register it in the developer portal
# (redirect address MQ_SITE_ORIGIN + /auth/mq/callback), approve it, put it in the
# sector group "muslimquotient", and paste its client ID and secret here.
MQ_SITE_CLIENT_ID=
MQ_SITE_CLIENT_SECRET=

# Where "Connect istighfar.club" and "Take your first Mohasaba" go.
MQ_ISTIGHFAR_URL=https://istighfar.club
MQ_MOHASABA_URL=https://app.mohasaba.io
